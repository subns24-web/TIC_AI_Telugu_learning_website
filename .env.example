# Student login (Supabase Auth) needs no environment variables: the project's public URL and
# publishable key are in src/lib/auth.tsx. Nothing to set in Vercel or .env.local for login.
#
# Only scripts/set-student-passwords.mjs needs a secret, and it reads it from your terminal:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (the sb_secret_ key), NEW_PASSWORD
# Never put the sb_secret_ key in a file that is committed.
