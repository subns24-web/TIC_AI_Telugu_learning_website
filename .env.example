# Student login (Supabase Auth). Public values from Supabase → Project Settings → API.
# Set them in Vercel → Project → Settings → Environment Variables, then redeploy.
# Without them, login is switched off and every page stays open.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
